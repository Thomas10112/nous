# ---------------------------------------------------------------
#  Mode partage (optionnel)
# ---------------------------------------------------------------
# Sans ce fichier, le site fonctionne en LOCAL : tout est stocke
# dans le navigateur de l'appareil. Parfait pour essayer.
#
# Pour que vous puissiez ecrire tous les deux depuis vos PC et vos
# telephones, creez un projet gratuit sur https://supabase.com,
# lancez le script supabase/schema.sql, puis copiez ce fichier en
# ".env" et remplissez les deux valeurs ci-dessous.
#
# (Project Settings > API)
# ---------------------------------------------------------------

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# La cle publique du projet. Supabase l affiche sous deux noms selon
# l age du projet : « anon public » (eyJ...) ou « publishable key »
# (sb_publishable_...). Les deux marchent, remplissez celle que vous voyez.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi....

# N utilisez JAMAIS la cle service_role / secret : elle contourne toutes
# les securites et se retrouverait dans le code envoye aux navigateurs.

# Identifiant de votre espace commun. Laissez "nous" ou mettez un mot
# secret : seules les personnes qui connaissent ce mot voient vos donnees.
VITE_SPACE_ID=nous
